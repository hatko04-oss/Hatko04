//@version=6
// FVG Longs Clean + magnets - longs only, any symbol, any timeframe.
// Medium-sized bullish FVGs (gap between min and max x ATR) are stored as
// zones. EVERY retrace back down into a zone triggers a market buy; when
// price leaves the zone and dips back again, it trades again. A zone dies
// when price closes below its bottom. Stop: below the zone bottom - ticks.
// TP: the NEAREST magnet above entry, from three kinds -
//   1. clean (unswept) ICT swing highs,
//   2. NWOG / NDOG midpoints (new week / day opening gaps),
//   3. volume imbalance midpoints (body gaps whose wicks still overlap).
// Magnets vanish once price trades through them; fixed R fallback if none.
strategy("FVG Longs Clean", overlay = true, initial_capital = 10000, pyramiding = 20, slippage = 10, calc_on_every_tick = false, process_orders_on_close = true, max_boxes_count = 100)

minGapAtr = input.float(0.2, "Min gap size (x ATR)", step = 0.05)
maxGapAtr = input.float(1.5, "Max gap size (x ATR)", step = 0.1)
stopBufTicks = input.int(3, "Stop buffer below zone (ticks)", minval = 0)
minStopAtr = input.float(0.3, "Min stop distance (x ATR)", step = 0.05)
riskPct = input.float(0.5, "Risk per trade (% equity)", step = 0.1)
tgtSwing = input.int(5, "Clean-high swing length", minval = 2)
rrFallback = input.float(4.0, "Fallback R:R (no magnet above)", step = 0.5)
useEma = input.bool(false, "Only long above trend EMA", inline = "e")
emaLen = input.int(100, "length", minval = 10, inline = "e")
maxOpen = input.int(5, "Max stacked trades", minval = 1, maxval = 20)
maxDD = input.float(20.0, "Halt when account down (%)", step = 5)

atr = ta.atr(14)
ema = ta.ema(close, emaLen)

f_sweepTouched(array<float> a) =>
    if array.size(a) > 0
        for i = array.size(a) - 1 to 0
            v = array.get(a, i)
            if high >= v and low <= v
                array.remove(a, i)

f_nearestAbove(array<float> a, float p, float best0) =>
    float best = best0
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if v > p and (na(best) or v < best)
                best := v
    best

//  Magnet 1: clean (unswept) swing highs
var array<float> cleanHighs = array.new_float()
ph = ta.pivothigh(high, tgtSwing, tgtSwing)
if not na(ph)
    array.unshift(cleanHighs, ph)
if array.size(cleanHighs) > 0
    for i = array.size(cleanHighs) - 1 to 0
        if high > array.get(cleanHighs, i)
            array.remove(cleanHighs, i)

//  Magnet 2: NWOG / NDOG midpoints (last 6)
var array<float> gapMids = array.new_float()
if (timeframe.change("W") or timeframe.change("D")) and not na(close[1])
    array.unshift(gapMids, (open + close[1]) / 2)
    if array.size(gapMids) > 6
        array.pop(gapMids)
f_sweepTouched(gapMids)

//  Magnet 3: volume imbalances (body gaps, wicks overlap; last 20)
var array<float> viMids = array.new_float()
if math.min(open, close) > math.max(open[1], close[1]) and low <= high[1]
    array.unshift(viMids, (math.min(open, close) + math.max(open[1], close[1])) / 2)
if math.max(open, close) < math.min(open[1], close[1]) and high >= low[1]
    array.unshift(viMids, (math.max(open, close) + math.min(open[1], close[1])) / 2)
if array.size(viMids) > 20
    array.pop(viMids)
f_sweepTouched(viMids)

halted = strategy.equity <= strategy.initial_capital * (1 - maxDD / 100)

//  FVG zones: check retraces on existing zones, drop broken ones.
// zOut = price was above the zone last bar, so this dip is a fresh retrace.
var array<float> zTop = array.new_float()
var array<float> zBot = array.new_float()
var array<bool> zOut = array.new<bool>()
float hitBot = na
if array.size(zTop) > 0
    for i = array.size(zTop) - 1 to 0
        t = array.get(zTop, i)
        b = array.get(zBot, i)
        if close < b
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zOut, i)
        else
            if low <= t and array.get(zOut, i) and (na(hitBot) or b > hitBot)
                hitBot := b
            array.set(zOut, i, low > t)

//  New medium-sized bullish FVG becomes a zone (checked from next bar on).
gapSz = low - high[2]
if low > high[2] and gapSz >= minGapAtr * atr and gapSz <= maxGapAtr * atr
    array.unshift(zTop, low)
    array.unshift(zBot, high[2])
    array.unshift(zOut, true)
    box.new(bar_index - 2, low, bar_index + 30, high[2], bgcolor = color.new(color.green, 85))
    if array.size(zTop) > 10
        array.pop(zTop)
        array.pop(zBot)
        array.pop(zOut)

//  Entry: one market buy per bar on the freshest retrace
var int n = 0
if not na(hitBot) and (not useEma or close > ema) and not halted and strategy.opentrades < maxOpen
    // Stop below the zone, but never closer than minStopAtr - a too-tight
    // stop makes position size explode and slippage eat far more than the
    // intended risk (this is what drained equity into the halt before).
    stopPx = math.min(hitBot - stopBufTicks * syminfo.mintick, close - minStopAtr * atr)
    dist = close - stopPx
    float tp = f_nearestAbove(cleanHighs, close, na)
    tp := f_nearestAbove(gapMids, close, tp)
    tp := f_nearestAbove(viMids, close, tp)
    if na(tp)
        tp := close + rrFallback * dist
    if dist > 0 and tp > close
        qty = strategy.equity * riskPct / 100 / (math.max(dist, syminfo.mintick) * syminfo.pointvalue)
        n += 1
        strategy.entry("L" + str.tostring(n), strategy.long, qty = qty)
        strategy.exit("x" + str.tostring(n), "L" + str.tostring(n), stop = stopPx, limit = tp)

plot(ema, "Trend EMA", color.new(color.orange, 40))
plot(array.size(gapMids) > 0 ? array.get(gapMids, 0) : na, "Latest NWOG/NDOG mid", color.new(color.purple, 30), style = plot.style_linebr)
plotchar(halted, "Halted", "X", location.top, color.red, size = size.tiny)
